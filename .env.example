# FloodGuard Environment Configuration
# NOTE: None of these keys are required for core flood safety features!
# All core hydrologic models, Open-Meteo flood queries, OSM shelters,
# reverse geocoding, offline TTS, and SOS work 100% free with NO API KEYS.

# Optional: Google Gemini API Key for dynamic multi-lingual AI translations and situational summaries.
# When running inside Google AI Studio, this is automatically injected.
# In local or GitHub Pages deployments, users can also paste this into the in-app Setup screen.
VITE_GEMINI_API_KEY=

# Optional: Serverless backend proxy URL for production deployments (Cloud Run / Firebase)
# If provided, Gemini requests and SMS alerts will be proxied through this endpoint to protect credentials.
VITE_PROXY_URL=
